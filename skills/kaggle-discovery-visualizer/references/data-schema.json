{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kaggle 候选数据集对比结果",
  "description": "kaggle-discovery 技能的产出：一次检索经逐个 kaggle_dataset_view 核对后的候选数据集对比结果。所有字段都来自 Kaggle MCP 工具的真实返回；Visualizer 不得补齐或推测缺失字段。",
  "type": "object",
  "required": ["query", "generatedFrom", "candidates"],
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "object",
      "description": "触发本次检索的用户意图，用于 Widget 抬头说明口径。",
      "required": ["search"],
      "additionalProperties": false,
      "properties": {
        "search": { "type": "string", "minLength": 1, "description": "实际使用的检索关键词。" },
        "sortBy": {
          "type": "string",
          "enum": ["relevance", "hottest", "active", "updated"],
          "description": "Kaggle API 仅接受这四个值。"
        },
        "page": { "type": "integer", "minimum": 1, "description": "每页固定 20 条。" },
        "intent": { "type": "string", "description": "用户想解决的问题，一句话；用于说明这份对比是为了什么。" }
      }
    },
    "generatedFrom": {
      "type": "object",
      "description": "来源与核对状态。fieldsVerified 为 false 时，界面必须标注“仅摘要级核对”。",
      "required": ["tools", "fieldsVerified"],
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["kaggle_search_datasets", "kaggle_dataset_view"] }
        },
        "fieldsVerified": {
          "type": "boolean",
          "description": "true 表示每个候选都调过 kaggle_dataset_view；false 表示只有检索摘要，字段未经核对。"
        },
        "verifiedAt": { "type": "string", "description": "ISO 8601 时间戳。" },
        "credentialsConfigured": {
          "type": "boolean",
          "description": "为 false 时，内核检索与竞赛列表不可用，应在界面提示而非静默省略。"
        }
      }
    },
    "candidates": {
      "type": "array",
      "description": "进入对比名单的数据集，按推荐顺序排列。空数组是合法状态，对应 Empty 分支。",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["ref", "title", "owner", "provenance"],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
            "description": "稳定标识符，也是 sendPrompt 的 selectedData 主键。"
          },
          "title": { "type": ["string", "null"] },
          "subtitle": { "type": ["string", "null"] },
          "owner": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "totalBytes": { "type": ["integer", "null"], "minimum": 0 },
          "sizeLabel": {
            "type": ["string", "null"],
            "description": "服务端已算好的可读体积；为空时用 totalBytes 在本地换算，不得两者都空。"
          },
          "downloadCount": { "type": ["integer", "null"], "minimum": 0 },
          "voteCount": { "type": ["integer", "null"], "minimum": 0 },
          "viewCount": { "type": ["integer", "null"], "minimum": 0 },
          "kernelCount": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "基于该数据集的公开 Notebook 数量，可作为社区验证度参考，但不等同于质量证明。"
          },
          "usabilityRating": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "Kaggle 的 0–1 可用性评分，为 0–1 之间的 bench 条可直接归一化使用。"
          },
          "licenseName": {
            "type": ["string", "null"],
            "description": "许可硬约束。null 表示未核对到，不代表可自由使用。"
          },
          "lastUpdated": { "type": ["string", "null"], "description": "ISO 8601。" },
          "currentVersionNumber": { "type": ["integer", "null"], "minimum": 0 },
          "versionCount": { "type": ["integer", "null"], "minimum": 0 },
          "fileCount": { "type": ["integer", "null"], "minimum": 0 },
          "fieldsKnown": {
            "type": "boolean",
            "description": "false 表示 kaggle_dataset_view 未返回列元数据，真实字段需下载后才能确认。"
          },
          "blockedReason": {
            "type": ["string", "null"],
            "enum": ["licence-unknown", "licence-restricted", "fields-unknown", "stale", "private", null],
            "description": "落地阻断原因；null 表示未发现阻断项。"
          },
          "note": { "type": ["string", "null"], "description": "一句话判断：它会在哪里翻车。" },
          "provenance": {
            "type": "object",
            "required": ["tool", "detailLevel"],
            "additionalProperties": false,
            "properties": {
              "tool": { "enum": ["kaggle_search_datasets", "kaggle_dataset_view"] },
              "detailLevel": { "enum": ["summary", "full"] }
            }
          }
        }
      }
    }
  }
}
